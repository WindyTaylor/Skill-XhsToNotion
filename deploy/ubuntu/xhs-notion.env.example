# Copy this file to /etc/xhs-notion/xhs-notion.env on the server.
# Fill real values on the server only. Do not commit secrets.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

NOTION_API_KEY=ntn_xxx
NOTION_DATABASE_ID=your_notion_database_id
NOTION_MATERIAL_DATABASE_ID=
NOTION_MATERIAL_DATA_SOURCE_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

NOTION_TIMEOUT=15
NOTION_VERIFY_SSL=false
COVER_CACHE_ENABLED=true
COVER_UPLOAD_TO_NOTION=true
# Leave empty to use /opt/xhs-notion/program/data/covers with this systemd template.
COVER_CACHE_DIR=
XHS_FETCH_MIN_INTERVAL_SECONDS=3
XHS_IMAGE_DOWNLOAD_INTERVAL_SECONDS=1
